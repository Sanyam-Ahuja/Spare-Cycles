sparecycles.sahuja.in {
    encode gzip

    # FastAPI: REST + WebSockets (/api/v1/ws/...), API docs, health
    handle /api/v1/* {
        reverse_proxy server:8000
    }
    handle /docs* {
        reverse_proxy server:8000
    }
    handle /redoc* {
        reverse_proxy server:8000
    }
    handle /openapi.json {
        reverse_proxy server:8000
    }
    handle /health {
        reverse_proxy server:8000
    }

    # Everything else: Next.js web app
    handle {
        reverse_proxy web:3000
    }
}

s3-sparecycles.sahuja.in {
    # Public S3 endpoint for presigned URLs (contributor node file access).
    # The Host header is passed through unchanged, which SigV4 signatures require.
    reverse_proxy minio:9000
}
